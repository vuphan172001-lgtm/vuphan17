async def add_acc_start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    accounts = load_accounts()
    if len(accounts) >= 10:
        await update.message.reply_text("❌ Đã đạt giới hạn tối đa 10 tài khoản!")
        return ConversationHandler.END
        
    await update.message.reply_text("📝 Gửi URL dạng userId=...&secretKey=... hoặc định dạng ID|Key vào khung chat:")
    return WAIT_ACC_INPUT

async def add_acc_process(update: Update, context: ContextTypes.DEFAULT_TYPE):
    inp = update.message.text.strip()
    u_id, u_key = None, None
    
    if 'http' in inp or 'userId' in inp:
        try:
            from urllib.parse import urlparse, parse_qs
            params = parse_qs(urlparse(inp).query)
            u_id = params.get('userId', [None])[0]
            u_key = params.get('secretKey', [None])[0]
        except Exception:
            pass
    elif '|' in inp:
        parts = inp.split('|')
        if len(parts) >= 2:
            u_id, u_key = parts[0].strip(), parts[1].strip()
            
    if u_id and u_key:
        name = get_user_info(u_id, u_key)
        accounts = load_accounts()
        accounts.append({'id': u_id, 'key': u_key, 'name': name})
        save_accounts(accounts)
        await update.message.reply_text(f"✅ Đã thêm tài khoản: *{name}*", parse_mode="Markdown")
    else:
        await update.message.reply_text("❌ Định dạng không hợp lệ, thao tác đã bị hủy.")
        
    return ConversationHandler.END

async def del_acc_start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    accounts = load_accounts()
    if not accounts:
        await update.message.reply_text("❌ Không có tài khoản nào để xóa!")
        return ConversationHandler.END
        
    text = "🔢 **Nhập STT tài khoản muốn xóa:**\n\n"
    for i, acc in enumerate(accounts, 1):
        text += f"*{i}.* {acc['name']} ({acc['id']})\n"
    await update.message.reply_text(text, parse_mode="Markdown")
    return WAIT_DEL_INDEX

async def del_acc_process(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        idx = int(update.message.text.strip()) - 1
        accounts = load_accounts()
        if 0 <= idx < len(accounts):
            removed = accounts.pop(idx)
            save_accounts(accounts)
            await update.message.reply_text(f"🗑️ Đã xóa tài khoản: *{removed['name']}*", parse_mode="Markdown")
        else:
            await update.message.reply_text("❌ STT không hợp lệ!")
    except Exception:
        await update.message.reply_text("❌ Vui lòng nhập số nguyên hợp lệ!")
    return ConversationHandler.END

