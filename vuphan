async def start_bot_process(update: Update, context: ContextTypes.DEFAULT_TYPE):
    accounts = load_accounts()
    if not accounts:
        await update.message.reply_text("❌ Vui lòng bấm *➕ Thêm Acc* để thêm ít nhất 1 tài khoản trước!")
        return ConversationHandler.END
        
    await update.message.reply_text("🎯 *Nhập mã Redcode cần chạy vào khung chat:*", parse_mode="Markdown")
    return WAIT_CODE_INPUT

async def process_code_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    code = update.message.text.strip()
    accounts = load_accounts()
    
    msg = await update.message.reply_text("🔄 Đang kiểm tra mã code...")
    res = check_code(accounts[0], code)
    
    if res.get('code') != 0:
        await msg.edit_text(f"❌ *Code lỗi hoặc không tồn tại:* {res.get('msg', 'Unknown')}", parse_mode="Markdown")
        return ConversationHandler.END
        
    data = res['data']
    context.user_data['code'] = code
    context.user_data['code_data'] = data
    
    val = float(data.get('value', 0))
    f_val = f"{val:,.0f}".replace(',', '.')
    created_ts = datetime.fromtimestamp(data.get('created_ts', 0)).strftime('%H:%M:%S %d/%m')
    expired_ts = datetime.fromtimestamp(data.get('expired_ts', 0)).strftime('%H:%M:%S %d/%m')
    remain = int(data.get('user_cnt', 0)) - int(data.get('progress', 0))
    
    info_text = (
        f"🎁 **THÔNG TIN CODE: {data.get('title', 'Unknown').upper()}**\n\n"
        f"• *Người tạo:* {data.get('nickname', 'Unknown')}\n"
        f"• *Phần thưởng:* {f_val} {data.get('currency', '').upper()}\n"
        f"• *Đã nhập:* `{data.get('progress', 0)} / {data.get('user_cnt', 0)}`\n"
        f"• *Lượt còn lại:* `{remain}`\n"
        f"• *Thời gian tạo:* {created_ts}\n"
        f"• *Hết hạn:* {expired_ts}\n\n"
        "👉 **Nhập ngưỡng lượt trống để canh (ví dụ: gõ 5 để tự chạy khi lượt còn lại <= 5). Nếu muốn chạy ngay lập tức, gõ 0:**"
    )
    await msg.edit_text(info_text, parse_mode="Markdown")
    return WAIT_THRES_INPUT

async def execute_run(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        thres = int(update.message.text.strip())
    except Exception:
        thres = 0
        
    code = context.user_data.get('code')
    accounts = load_accounts()
    
    status_msg = await update.message.reply_text(f"⏳ **Khởi tạo tiến trình canh code {code}...**", parse_mode="Markdown")
    
    # Canh lượt trống nếu thres > 0
    if thres > 0:
        last_rem = None
        while True:
            c_res = check_code(accounts[0], code)
            if c_res.get('code') != 0:
                await status_msg.edit_text("❌ Code không còn khả dụng hoặc đã hết lượt!")
                return ConversationHandler.END
                
            inf = c_res['data']
            rem = int(inf['user_cnt']) - int(inf['progress'])
            
            if rem != last_rem:
                await status_msg.edit_text(f"🕵️ **Đang canh code...**\n• Còn lại: {rem} lượt\n• Ngưỡng kích hoạt: {thres}", parse_mode="Markdown")
                last_rem = rem
            
            if rem <= thres:
                await update.message.reply_text(f"⚡ *ĐẠT NGƯỠNG {thres}! KÍCH HOẠT TURBO CHẠY CODE...*")
                break
            await asyncio.sleep(1)

    # Chạy nhập code đa luồng cho các tài khoản
    await status_msg.edit_text(f"🚀 *Đang chạy {len(accounts)} tài khoản...*", parse_mode="Markdown")
    
    succeeded_indices = set()
    max_rounds = 20
    results_log = []

    def process_acc(idx, acc):
        if idx in succeeded_indices:
            return
        try:
            res = exchange_code(acc, code)
            code_res = res.get('code')
            if code_res == 0:
                v = float(res['data']['value'])
                cur = res['data']['currency'].lower()
                total_harvested[cur] += v
                now_str = datetime.now().strftime('%H:%M:%S')
                history_records.append([now_str, f"{acc['name']}", f"+{v:,.2f}", cur.upper()])
                results_log.append(f"✅ {acc['name']}: +{v} {cur.upper()}")
                succeeded_indices.add(idx)
            elif code_res == 100306:
                results_log.append(f"⚠️ {acc['name']}: Đã nhập trước đó")
                succeeded_indices.add(idx)
            else:
                results_log.append(f"❌ {acc['name']}: Lỗi {code_res}")
        except Exception:
            results_log.append(f"❌ {acc['name']}: Lỗi kết nối")

    for round_num in range(1, max_rounds + 1):
        if len(succeeded_indices) == len(accounts):
            break
        with ThreadPoolExecutor(max_workers=20) as executor:
            futures = [executor.submit(process_acc, idx, acc) for idx, acc in enumerate(accounts)]
            for f in futures:
                f.result()

    summary_text = "🎉 **KẾT QUẢ NHẬP CODE:**\n\n" + "\n".join(results_log[-15:])
    await update.message.reply_text(summary_text, parse_mode="Markdown")
    
    # Đồng bộ lại số dư tài sản
    update_all_wallets(accounts)
    return ConversationHandler.END

async def cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("❌ Đã hủy thao tác.", reply_markup=get_main_keyboard())
    return ConversationHandler.END

# ==========================================
# 🚀 KHỞI CHẠY BOT
# ==========================================
def main():
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    add_acc_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex("^➕ Thêm Acc$"), add_acc_start)],
        states={WAIT_ACC_INPUT: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_acc_process)]},
        fallbacks=[CommandHandler("cancel", cancel)],
    )

    del_acc_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex("^➖ Xóa Acc$"), del_acc_start)],
        states={WAIT_DEL_INDEX: [MessageHandler(filters.TEXT & ~filters.COMMAND, del_acc_process)]},
        fallbacks=[CommandHandler("cancel", cancel)],
    )

    run_code_handler = ConversationHandler(
        entry_points=[MessageHandler(filters.Regex("^Bắt đầu$"), start_bot_process)],
        states={
            WAIT_CODE_INPUT: [MessageHandler(filters.TEXT & ~filters.COMMAND, process_code_input)],
            WAIT_THRES_INPUT: [MessageHandler(filters.TEXT & ~filters.COMMAND, execute_run)],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
    )

    app.add_handler(CommandHandler("start", start_command))
    app.add_handler(MessageHandler(filters.Regex("^📊 Dashboard$"), show_dashboard))
    app.add_handler(MessageHandler(filters.Regex("^📋 Danh sách Acc$"), list_accounts))
    
    app.add_handler(add_acc_handler)
    app.add_handler(del_acc_handler)
    app.add_handler(run_code_handler)

    print("Bot Telegram đang chạy...")
    app.run_polling()

if __name__ == '__main__':
    main()
